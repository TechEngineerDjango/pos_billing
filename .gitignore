# ============================================================
# Burger POS — .gitignore
# ============================================================

# Environment & Secrets
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
# Virtual Environments
venv/
env/
.venv/
pos_env/

# Database files
*.db
*.sqlite3

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
error_screenshot.png
cookies.txt
server*.log
app.log

# Pytest
.pytest_cache/

# Uploads (user content — back up separately)
static/uploads/*
!static/uploads/.gitkeep

# Scratch / temp
scratch/

# Agent config (local only)
.agents/
ai-tools/
*.pem

# Frontend Build Tools
node_modules/
package.json
package-lock.json
tailwind.config.js
static/css/input.css
# static/css/styles.css is now TRACKED for production

# Image file
*.jpeg
*.png
*.jpg
*.gif
*.webp
*.svg
*.ico
*.tiff
*.bmp