# ======================================
# Burger POS — Environment Configuration
# ======================================
# Copy this file to .env and fill in values.

# REQUIRED — Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./burger_pos.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/burger_pos

# Security
IS_PRODUCTION=false
ALLOWED_ORIGINS=http://localhost:8000

# Printer
DEFAULT_PRINTER_IP=mock
