# ======================================
# Burger POS — Environment Configuration
# ======================================
# Copy this file to .env and fill in values.

# REQUIRED — Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Database (PostgreSQL) — DATABASE_URL is built from these, not read directly
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos

# Security
IS_PRODUCTION=false
ALLOWED_ORIGINS=http://localhost:8000

# Printer
DEFAULT_PRINTER_IP=mock
